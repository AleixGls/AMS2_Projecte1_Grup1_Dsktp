<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<!--En el fx controller del Vbox, es de ejemplo, cambiar cuando este hecho el servidor -->

<VBox fx:controller="com.platea.desktop.CtrlConnexio "alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="PLATEA" />
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Connexió al servidor" />
      <VBox prefHeight="200.0" prefWidth="100.0">
         <children>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Label text="Ubicació" />
                  <ComboBox fx:id="ComboBoxUbicacion" prefWidth="150.0" visibleRowCount="3" />
               </children>
            </HBox>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Label text="Servidor" />
                  <TextField fx:id="TextServidor" />
               </children>
            </HBox>
         </children>
      </VBox>
      <Button fx:id="buttonConnecta" mnemonicParsing="false" text="Conecta" onAction="#onConnecta" />
   </children>
</VBox>
